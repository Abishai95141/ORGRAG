# Copy to .env and fill in. `docker compose up` reads this file.

# Required: signs session cookies. Generate with: openssl rand -hex 32
SECRET_KEY=
# Fernet keys for connector secrets at rest, comma-separated (first encrypts).
# Empty derives one from SECRET_KEY. Rotate: python -m app.core.crypto rotate
SECRETS_ENCRYPTION_KEYS=

# ── LLM ── set at least one key. Without any, Strata runs in retrieval-only mode.
# NVIDIA API (build.nvidia.com): open models such as Nemotron 3 Ultra, plus the reranker.
NVIDIA_API_KEY=
# Anthropic: Claude models.
ANTHROPIC_API_KEY=
# Default model for new orgs, and the fallback when an org's saved model can't run.
# Empty = Nemotron 3 Ultra with only an NVIDIA key, Claude Opus 5.5 otherwise.
# Recommended with an Anthropic key: claude-haiku-5-5 (fast, cheap, prompt caching and
# citations; see docs/PLAN-WEEKS-3-5.md). Via Experiential Labs: explabs:claude-haiku-5.5.
LLM_MODEL=
# Claude server-side refusal fallbacks (beta). Set to "off" to disable.
LLM_FALLBACKS=default
# Claude prompt caching in the agent loop. Set to false only to measure what it saves.
PROMPT_CACHING=true

# ── Retrieval ──
# Embeddings. fastembed runs locally (model baked into the image).
# Changing the dimension requires a fresh database (it's fixed by the first migration).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# For EMBEDDING_PROVIDER=voyage, e.g. EMBEDDING_MODEL=voyage-3.5-lite, EMBEDDING_DIM=1024
VOYAGE_API_KEY=
# Reranking: auto = NVIDIA Nemotron reranker with an NVIDIA key, else a local
# cross-encoder. Options: auto | nvidia | fastembed | none
RERANK_PROVIDER=auto

# Experiential Labs gateway (OpenAI-compatible, experientiallabs.ai). Its models are
# named "explabs:<model-id>".
EXPLABS_API_KEY=
# Claude's native citations (search_result blocks). Off: the model types [n], which
# measured better on Haiku 5.5 (it cites synthesized claims too).
CLAUDE_CITATIONS=false
# Sufficient-context check before answering: deep (default), always (adds quick mode;
# measured ~2x quick latency for +16 points on multi-hop) or off.
SUFFICIENCY_CHECK=deep

# Rich parsing with Docling (install the backend's `parsing` extra): PDF with OCR and
# tables, Word, Excel, PowerPoint (as pages, with LibreOffice), email, images, legacy
# Office. Runs once per document, in worker processes. off = the light PDF/DOCX parsers.
DOCLING=auto
DOCLING_WORKERS=2
DOCLING_TIMEOUT_SECONDS=600
# Prefetched models (`docling-tools models download layout tableformer rapidocr`); empty
# downloads them on first use.
DOCLING_ARTIFACTS_PATH=
# Optional, at indexing only: pages Docling reads weakly (little text, mostly pictures
# or charts, garbled OCR) are transcribed by Claude Haiku. Measured: 27 weak pages in
# 15 real files for about $0.01. Off: indexing uses no LLM.
VISION_PARSING=false

# Keyword ranking: auto = BM25 (pg_textsearch) when its index exists, else ts_rank_cd;
# ts_rank forces the fallback; bm25 warns when the index is missing.
KEYWORD_RANKING=auto

# Contextual Retrieval: a model-written context per chunk, embedded and keyword-indexed
# with it (Anthropic key needed). Measured: small gain on short documents, off by default.
CONTEXTUAL_RETRIEVAL=false
CONTEXT_MODEL=claude-haiku-5-5

# Knowledge graph extraction (Settings → Knowledge graph). Empty = each org's model.
# With an Anthropic key, claude-haiku-5-5 (no fallback needed). Otherwise a free model
# first, with a paid fallback for rate limits and the free tier's daily cap.
# Measured: gpt-5.4-nano captured 20/20 test facts at ~$1.40 per 1,000 chunks.
GRAPH_EXTRACTION_MODEL=
GRAPH_EXTRACTION_FALLBACK_MODEL=
# Most model requests in flight per provider per process.
NVIDIA_MAX_CONCURRENCY=4

# ── Web search tool ── optional; orgs turn it on in Settings. One key is enough.
TAVILY_API_KEY=
BRAVE_API_KEY=

POSTGRES_PASSWORD=postgres
# Set true when serving over HTTPS.
# With COOKIE_SECURE=true (HTTPS) the API refuses the built-in or a short SECRET_KEY.
COOKIE_SECURE=false

# Longest a chat answer may run before it is stopped (seconds).
# CHAT_RUN_TIMEOUT_SECONDS=900

# Where people reach Strata (the web app). Used by the MCP server, and for the Slack
# bot's OAuth redirect, events URL and the links it posts.
# PUBLIC_URL=http://localhost:3000

# ── Slack bot ── optional; see README "Slack bot". From your Slack app's Basic
# Information page. All three are needed; then admins connect workspaces under
# Settings → Slack. Slack must reach PUBLIC_URL over HTTPS.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Tracing (OpenTelemetry). Off unless one of these is set. Langfuse: its project keys,
# and LANGFUSE_HOST for a self-hosted instance. Any other OTLP/HTTP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT (+ OTEL_EXPORTER_OTLP_HEADERS as key=value,key=value).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# Also send question, answer and tool-argument text (off: timings, tokens, ids only).
# TRACE_CONTENT=false
